{
  "expo": {
    "name": "united",
    "scheme": "united",
    "slug": "united",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "newArchEnabled": true,
      "bundleIdentifier": "com.amx100.united"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "newArchEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.amx100.united"
    },
    "web": {
      "favicon": "./assets/nnc-min.ico"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "nodeModulesPath": "./node_modules",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6d3ad863-6cf3-4d84-a99e-66cbe96d52ef"
      }
    },
    "experiments": {
      "tsconfigPaths": true,
      "newArchEnabled": true
    },
    "owner": "amx100"
  }
}
